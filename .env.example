APP_NAME=earnmart-api
APP_ENV=development
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Hệ thống đang bảo trì. Vui lòng thử lại sau.
TERMS_VERSION=2026-10-08
TERMS_CONTENT=Điều khoản sử dụng EarnMart
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
CORS_ALLOW_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=earnmart
DB_USER=earnmart
DB_PASSWORD=earnmart_secret
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
MIGRATIONS_URL=file://migrations

BCRYPT_COST=12
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TOKEN_TTL=10m
RESET_TICKET_TTL=10m
OTP_PEPPER=replace-with-a-random-server-secret
AUTH_EXPOSE_TEST_OTP=false
GOOGLE_CLIENT_IDS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
